# Set to "development" to allow HTTP connections and use the dev script
# EXPO_PUBLIC_APP_ENV=development

# Health check path (default: health)
# EXPO_PUBLIC_HEALTH_PATH=health

# Payment provider: "mock" for dev/testing, "ashrait" for real Caspit terminal
# EXPO_PUBLIC_PAYMENT_PROVIDER=mock

# Caspit terminal ID is now stored in SecureStore via the setup wizard, not in .env
